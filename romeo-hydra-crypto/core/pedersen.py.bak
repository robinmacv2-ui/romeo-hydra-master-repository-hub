from __future__ import annotations

import hashlib
import secrets


# ============================================================
# RFC 3526 — MODP Group 14
# 2048-bit safe-prime group
# Generator: 2
# ============================================================

P_HEX = (
    "FFFFFFFFFFFFFFFFC90FDAA22168C234C4C6628B80DC1CD1"
    "29024E088A67CC74020BBEA63B139B22514A08798E3404DD"
    "EF9519B3CD3A431B302B0A6DF25F14374FE1356D6D51C245"
    "E485B576625E7EC6F44C42E9A637ED6B0BFF5CB6F406B7ED"
    "EE386BFB5A899FA5AE9F24117C4B1FE649286651ECE45B3D"
    "C2007CB8A163BF0598DA48361C55D39A69163FA8FD24CF5F"
    "83655D23DCA3AD961C62F356208552BB9ED529077096966D"
    "670C354E4ABC9804F1746C08CA18217C32905E462E36CE3B"
    "E39E772C180E86039B2783A2EC07A28FB5C55DF06F4C52C9"
    "DE2BCBF6955817183995497CEA956AE515D2261898FA0510"
    "15728E5A8AACAA68FFFFFFFFFFFFFFFF"
)

P = int(P_HEX, 16)

# Subgroup order.
Q = (P - 1) // 2

G = 2

# Canonical width for Group 14.
P_BYTES = 256
P_HEX_WIDTH = 512


# ============================================================
# Domain-separated secondary generator
# ============================================================

def _hash_to_group(domain_string: str, p: int) -> int:
    """
    Deterministically derive a subgroup element.

    The SHA-256 digest is interpreted as an integer and squared
    modulo p, placing the result in the quadratic-residue subgroup.
    """

    if not isinstance(domain_string, str):
        raise TypeError("domain_string debe ser str")

    if p <= 3 or p % 2 == 0:
        raise ValueError("p debe ser un primo impar válido")

    digest = hashlib.sha256(
        domain_string.encode("utf-8")
    ).digest()

    h_base = int.from_bytes(
        digest,
        byteorder="big",
    ) % p

    if h_base == 0:
        h_base = 2

    h = pow(
        h_base,
        2,
        p,
    )

    if h in (0, 1):
        raise ValueError(
            "El dominio produjo un elemento degenerado"
        )

    return h


H = _hash_to_group(
    "ROMEO-HYDRA/PEDERSEN/H_GENERATOR_V1",
    P,
)


# ============================================================
# Validation
# ============================================================

def _validate_message(m: int) -> None:
    if not isinstance(m, int):
        raise TypeError("m debe ser int")

    if not 0 <= m < Q:
        raise ValueError(
            "El mensaje m debe pertenecer a Z_q"
        )


def _validate_randomness(r: int) -> None:
    if not isinstance(r, int):
        raise TypeError("r debe ser int")

    if not 0 <= r < Q:
        raise ValueError(
            "El factor r debe pertenecer a Z_q"
        )


def _validate_commitment(c: int) -> None:
    if not isinstance(c, int):
        raise TypeError(
            "El commitment debe ser int"
        )

    if not 1 <= c < P:
        raise ValueError(
            "El commitment debe pertenecer a Z_p*"
        )


# ============================================================
# Pedersen
# ============================================================

def commit(
    m: int,
    r: int | None = None,
) -> tuple[int, int]:
    """
    Pedersen commitment:

        C = G^m * H^r mod P

    with m,r in Z_q.
    """

    _validate_message(m)

    if r is None:
        r = secrets.randbelow(Q)
    else:
        _validate_randomness(r)

    c = (
        pow(G, m, P)
        * pow(H, r, P)
    ) % P

    return c, r


def verify(
    c: int,
    m: int,
    r: int,
) -> bool:
    """
    Verify:

        C == G^m * H^r mod P
    """

    if not isinstance(c, int):
        return False

    if not isinstance(m, int):
        return False

    if not isinstance(r, int):
        return False

    if not 0 <= m < Q:
        return False

    if not 0 <= r < Q:
        return False

    if not 1 <= c < P:
        return False

    expected = (
        pow(G, m, P)
        * pow(H, r, P)
    ) % P

    return c == expected


def combine(
    c1: int,
    c2: int,
) -> int:
    """
    Homomorphic combination:

        C1 * C2 mod P
    """

    _validate_commitment(c1)
    _validate_commitment(c2)

    return (c1 * c2) % P


def verify_sum(
    c_list: list[int],
    total_m: int,
    total_r: int,
) -> bool:
    """
    Verify the homomorphic sum in Z_q.
    """

    if not c_list:
        raise ValueError(
            "La lista de compromisos no puede estar vacía"
        )

    total_m_mod_q = total_m % Q
    total_r_mod_q = total_r % Q

    c_product = 1

    for c in c_list:
        _validate_commitment(c)
        c_product = (
            c_product * c
        ) % P

    return verify(
        c_product,
        total_m_mod_q,
        total_r_mod_q,
    )


# ============================================================
# Canonical commitment serialization
# ============================================================

def commitment_to_hex(c: int) -> str:
    """
    Canonical Group-14 encoding.

    2048 bits = 256 bytes = 512 hexadecimal characters.
    """

    _validate_commitment(c)

    return c.to_bytes(
        P_BYTES,
        byteorder="big",
    ).hex()


def commitment_from_hex(value: str) -> int:
    """
    Decode canonical Group-14 commitment.
    """

    if not isinstance(value, str):
        raise TypeError(
            "El commitment debe ser str"
        )

    if len(value) != P_HEX_WIDTH:
        raise ValueError(
            "El commitment debe contener "
            f"exactamente {P_HEX_WIDTH} caracteres hex"
        )

    try:
        raw = bytes.fromhex(value)
    except ValueError as exc:
        raise ValueError(
            "El commitment contiene hexadecimal inválido"
        ) from exc

    c = int.from_bytes(
        raw,
        byteorder="big",
    )

    _validate_commitment(c)

    return c


# ============================================================
# Structural invariants
# ============================================================

if P.bit_length() != 2048:
    raise RuntimeError(
        "RFC 3526 Group 14 inválido: P no tiene 2048 bits"
    )

if len(P_HEX) != 512:
    raise RuntimeError(
        "RFC 3526 Group 14 inválido: P_HEX no tiene 512 hex"
    )

if P_BYTES != 256:
    raise RuntimeError(
        "Ancho binario inválido para Group 14"
    )

if P_HEX_WIDTH != 512:
    raise RuntimeError(
        "Ancho hexadecimal inválido para Group 14"
    )

if G != 2:
    raise RuntimeError(
        "Generador RFC 3526 inválido"
    )

if not 1 < H < P:
    raise RuntimeError(
        "H está fuera de Z_p*"
    )
